(ns marketentry.facts-test
  (:require [kotoba.test :refer [deftest is testing]]
            [marketentry.facts :as facts]))

(deftest lca-has-spec-basis
  (let [sb (facts/spec-basis "LCA")]
    (is (some? sb))
    (is (string? (:provenance sb)))
    (is (seq (:required-evidence sb)))
    (is (some? (facts/corporate-number-spec-basis "LCA")))
    (is (some? (facts/business-registration-spec-basis "LCA")))
    (is (some? (facts/suspension-window-spec-basis "LCA")))))

(deftest lca-rep-spec-basis-is-populated
  (testing "s.114(4) extends suspension to named directors/shareholders/staff -- genuinely populated, unlike ATG's honest nil"
    (is (some? (facts/rep-spec-basis "LCA")))))

(deftest unknown-jurisdiction-has-no-spec-basis
  (is (nil? (facts/spec-basis "ATL")))
  (is (nil? (facts/spec-basis "ZZZ"))))

(deftest required-evidence-satisfied
  (let [sb (facts/spec-basis "LCA")
        all (:required-evidence sb)]
    (is (true? (facts/required-evidence-satisfied? "LCA" all)))
    (is (not (facts/required-evidence-satisfied? "LCA" (take 1 all))))
    (is (nil? (facts/required-evidence-satisfied? "ATL" all)))))

(deftest coverage-is-honest
  (let [c (facts/coverage ["LCA" "USA" "ATL"])]
    (is (= 3 (:requested c)))
    (is (= 2 (:covered c)))
    (is (= ["ATL"] (:missing-jurisdictions c)))))
